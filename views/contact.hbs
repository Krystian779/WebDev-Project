<main>
  <section id="contact">

    <div class="container-sm">
      <h1>Contact Us</h1><br />
      <h3>Enter your email and a message about any questions you may have or
        about any problems when using our website here:</h3>
      <div class="form-floating mb-3">
        <input
          type="email"
          class="form-control"
          id="floatingInput"
          placeholder="name@example.com"
        />
        <label for="floatingInput">Email address</label>
      </div>
      <div class="form-floating">
        <input
          type="message"
          class="form-control"
          id="floatingMessage"
          placeholder="Your message here"
        />
        <label for="floatingMessage">Message</label>
      </div><br />
      <button
        id="contactBtn"
        type="button"
        class="btn btn-primary"
      >Submit</button>
    </div>
  </section>

</main>